{
  "name": "cdut-verify",
  "version": "0.1.0",
  "description": "Offline verifier for CDU .cdut transcripts, with programme-manifest completeness checking",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Muzi Dlamini",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muziconsulting-cloud/cdut-verify.git"
  },
  "homepage": "https://github.com/muziconsulting-cloud/cdut-verify#readme",
  "keywords": ["transcript", "verification", "ed25519", "education", "cdut"],
  "bin": {
    "cdut-verify": "./src/cli.ts"
  },
  "scripts": {
    "verify": "bun src/cli.ts",
    "test": "bun test",
    "test:baseline": "bun test test/transcript.test.ts",
    "typecheck": "bun x tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
